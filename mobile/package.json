{
  "name": "syroce-pms-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "smoke": "bash scripts/smoke.sh",
    "smoke:doctor": "command -v maestro >/dev/null 2>&1 && maestro --version || (echo 'Maestro CLI missing. See mobile/.maestro/README.md' && exit 127)",
    "test": "npm run test:unit",
    "test:unit": "rm -rf .unit-build && tsc -p tsconfig.unit.json && node --test $(find .unit-build -name '*.test.js')",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "doctor": "expo-doctor",
    "validate:config": "node scripts/validate-config.mjs",
    "check": "npm run validate:config && npm run typecheck && npm run test:unit && npm run doctor",
    "test:e2e:smoke": "playwright test --config=e2e/playwright.config.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-async-storage-persister": "^5.59.0",
    "@tanstack/query-sync-storage-persister": "^5.59.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-persist-client": "^5.59.0",
    "expo": "^57.0.18",
    "expo-brightness": "~57.0.1",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.16",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.14",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^26.4.0",
    "@types/react": "~19.2.10",
    "expo-doctor": "^1.20.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "tar": ">=7.5.19"
  },
  "private": true
}
